# Simple Dockerfile for workers (doesn't require base image)
# Use this until ghcr.io/bopoadz-del/cerebrum-ml-base:latest is publicly available
# Cache-bust: 2026-04-07-01

FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV ENVIRONMENT=production

WORKDIR /app
RUN apt-get update && apt-get install -y \
    gcc \
    libpq-dev \
    libpq5 \
    curl \
    wget \
    gnupg \
    lsb-release \
    postgresql-client \
    && rm -rf /var/lib/apt/lists/*

# Install all dependencies (including ML)
COPY requirements-full.txt .
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements-full.txt

# Cache-bust layer
COPY .docker_nocache /tmp/.docker_nocache
COPY . .

RUN addgroup --system app && adduser --system --ingroup app app
USER app

# Worker-specific command should be set in render.yaml or dockerCommand
