      "inputs": [
        {"name": "mass", "type": "float", "unit": "kg", "required": true, "description": "Worker mass with tools"},
        {"name": "fall_factor", "type": "float", "unit": "", "required": true, "default": 2.0}
      ],
      "outputs": [{"name": "result", "type": "float", "unit": "kN"}],
      "references": ["OSHA 1926.502", "ANSI Z359"],
      "tags": ["fall protection", "safety", "force"]
