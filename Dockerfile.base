# Cerebrum ML Base Image
# Pre-installs heavy ML dependencies to cache between deploys
# Build and push to registry once, use in all deploys

FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libpq-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy and install heavy ML requirements
COPY backend/requirements-ml.txt .
RUN pip install --no-cache-dir -r requirements-ml.txt

# Pre-download common models (optional - speeds up first run)
# Uncomment if you want models baked into the image
# RUN python -c "from sentence_transformers import SentenceTransformer; SentenceTransformer('all-MiniLM-L6-v2')"

# This image is just a base - the main Dockerfile will add app code
